---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found — Sidewinder Labs" description="This page doesn't exist.">
	<section class="section">
		<div class="wrap">
			<span class="eyebrow">404</span>
			<h1>No tracks here.</h1>
			<p class="lede">The page you were looking for doesn't exist, or it has moved.</p>
			<div class="btn-row">
				<a class="btn btn--primary" href="/">Go to the home page</a>
				<a class="btn btn--ghost" href="/blog/">Read the blog</a>
			</div>
		</div>
	</section>
</Base>
