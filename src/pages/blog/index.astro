---
import Base from '../../layouts/Base.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Base title="Blog — Sidewinder Labs" description="Release notes and posts about Sidewinder Flow Studio.">
	<section class="section">
		<div class="wrap">
			<span class="eyebrow">Blog</span>
			<h1>Release notes and posts</h1>
			<p class="lede">What changed in Flow Studio, and why. <a href="/rss.xml">RSS feed</a></p>
			<ul class="posts">
				{posts.map((post) => (
					<li>
						<a class="card post" href={`/blog/${post.id}/`}>
							<p class="muted date"><FormattedDate date={post.data.pubDate} /></p>
							<h2>{post.data.title}</h2>
							<p class="muted">{post.data.description}</p>
						</a>
					</li>
				))}
			</ul>
		</div>
	</section>
</Base>

<style>
	.posts {
		list-style: none;
		margin: 40px 0 0;
		padding: 0;
		display: grid;
		gap: 16px;
		max-width: 46rem;
	}
	.post {
		display: block;
		text-decoration: none;
		color: inherit;
		transition: border-color 0.12s ease;
	}
	.post:hover {
		border-color: var(--sand-deep);
	}
	.post h2 {
		font-size: 1.35rem;
		margin-bottom: 0.3em;
	}
	.post p {
		margin: 0;
	}
	.date {
		font-size: 0.9rem;
		margin-bottom: 6px !important;
	}
</style>
