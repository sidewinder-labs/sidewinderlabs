---
import { REPO_URL, RELEASES_URL, DOCS_URL } from '../consts';
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="wrap row">
		<p>© {year} Sidewinder Labs. All rights reserved.</p>
		<ul>
			<li><a href={REPO_URL}>GitHub</a></li>
			{DOCS_URL && <li><a href={DOCS_URL}>Documentation</a></li>}
			<li><a href={RELEASES_URL}>Releases</a></li>
		</ul>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--border);
		padding: 28px 0;
		font-size: 0.92rem;
		color: var(--text-muted);
	}
	.row {
		display: flex;
		flex-wrap: wrap;
		gap: 12px 24px;
		align-items: center;
		justify-content: space-between;
	}
	p { margin: 0; }
	ul {
		display: flex;
		gap: 20px;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	a { color: var(--text-muted); }
	a:hover { color: var(--heading); }
</style>
